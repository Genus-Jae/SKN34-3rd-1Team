# LLM 지원사업 후보 점수화
# 실제 키는 로컬 .env에만 입력하고 커밋하지 마세요.
OPENAI_API_KEY=
# 조건 해석·RAG 답변은 기존 비용 중심 모델을 유지합니다.
OPENAI_MODEL=gpt-5.6-luna
# 정확도 우선 랭킹 권장 프로필. Luna/none보다 비용·응답 지연이 증가할 수 있습니다.
# 모델을 비워 두면 OPENAI_MODEL을 상속합니다. 추론 수준은 none 또는 low만 지원합니다.
OPENAI_RANKING_MODEL=gpt-5.6-sol
OPENAI_RANKING_REASONING_EFFORT=low
# Fast 상시 사용 프로필: 랭킹 토큰 단가 2배. 일반 처리는 default로 변경합니다.
OPENAI_RANKING_SERVICE_TIER=priority
LLM_MODEL_TIMEOUT_SECONDS=25.0
LLM_RUN_TIMEOUT_SECONDS=30.0
# 원문 자격을 검토하는 후보 점수화에만 별도 시간 예산을 사용합니다.
LLM_RANKING_MODEL_TIMEOUT_SECONDS=45.0
LLM_RANKING_RUN_TIMEOUT_SECONDS=50.0
# Core API 제한시간은 agent run 제한시간보다 응답 처리 여유만큼 길게 유지합니다.
AI_SERVICE_READ_TIMEOUT=35s
AI_RANKING_READ_TIMEOUT=55s

# 검색·근거 답변 합산, 한 Core 프로세스 기준. IP는 신원이 아니며 프록시/NAT 뒤에서는 한도를 공유합니다.
SUPPORT_PROGRAM_REQUEST_PER_CLIENT_PER_MINUTE=6
SUPPORT_PROGRAM_REQUEST_GLOBAL_PER_MINUTE=60
SUPPORT_PROGRAM_REQUEST_MAX_CONCURRENT=4

# 전체 공고 의미 검색. 공고/질의 임베딩 생성 시 OpenAI 사용 비용이 발생합니다.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=15
QDRANT_TIMEOUT_SECONDS=5
QDRANT_HOST_PORT=6333
AI_SEMANTIC_SEARCH_READ_TIMEOUT=30s
# MySQL의 현재 공고와 Qdrant를 비교하고 누락·변경된 벡터를 재처리합니다.
SUPPORT_PROGRAM_INDEX_ENABLED=true
SUPPORT_PROGRAM_INDEX_INITIAL_DELAY=PT0S
SUPPORT_PROGRAM_INDEX_FIXED_DELAY=PT1M
# AI Service를 Compose 밖에서 실행할 때만 지정합니다.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=

# Core API 지원사업 카탈로그용 로컬 MySQL. Compose는 DB를 loopback 주소로만 공개합니다.
# 운영·공유 환경에서는 두 비밀번호를 별도 secret으로 바꾸세요.
MYSQL_DATABASE=govbiz
MYSQL_USER=govbiz
MYSQL_PASSWORD=govbiz-local
MYSQL_ROOT_PASSWORD=govbiz-root-local
MYSQL_HOST_PORT=3306

# 백그라운드 기업마당 공고 동기화에만 사용하는 공공데이터포털 개인 서비스키
# 사용자 검색은 MySQL 카탈로그를 읽으며 외부 API를 직접 호출하지 않습니다.
# Encoding 또는 Decoding 키를 그대로 입력하면 Core API가 동기화 외부 호출 전에 정규화합니다.
DATA_GO_KR_SERVICE_KEY=

# "로그인 상태 유지"를 켠 세션의 절대 만료 기간(ISO-8601). 기본 30일
ACCOUNT_SESSION_TTL=P30D
# "로그인 상태 유지"를 끈 세션의 절대 만료 기간. 기본 12시간
ACCOUNT_SESSION_SHORT_TTL=PT12H
# 마지막 사용 뒤 세션을 끝내는 유휴 기간. 기본 7일
ACCOUNT_SESSION_IDLE_TTL=P7D
# 세션 JWT의 HS256 서명 비밀키(32자 이상). Core API 코드에는 기본값이 없어 비어 있으면 기동하지 않습니다. 운영 환경에서는 반드시 바꿉니다.
ACCOUNT_JWT_SECRET=govbiz-local-jwt-secret-change-in-production
# 세션 쿠키의 Secure 속성. 로컬 http 개발에서는 false, HTTPS 운영에서는 true
ACCOUNT_COOKIE_SECURE=false
# 개발용 자동 로그인. true면 POST /api/v1/auth/dev-login이 관리자 또는 회원 시드 계정(없으면 생성)의 세션을 발급합니다.
# 운영 환경에서는 반드시 false로 둡니다.
ACCOUNT_DEV_LOGIN_ENABLED=true
ACCOUNT_DEV_LOGIN_EMAIL=admin@govbiz.local
ACCOUNT_DEV_LOGIN_MEMBER_EMAIL=member@govbiz.local
ACCOUNT_DEV_LOGIN_PASSWORD=govbiz-admin1

# 기업 등록 시 사업자등록번호로 국세청 등록 여부·상호·사업자 상태를 확인하는 Bizno(bizno.net) API 키.
# 비어 있으면 기업 조회·등록 요청은 503 BIZNO_NOT_CONFIGURED를 반환하고 다른 기능에는 영향이 없습니다.
BIZNO_API_KEY=
BIZNO_URL=https://bizno.net/api/fapi

# Core API가 허용할 브라우저 origin(쉼표로 여러 개). CORS와 세션 쿠키 요청의 Origin 검사에 함께 쓰입니다.
APP_CORS_ALLOWED_ORIGIN=http://127.0.0.1:5173

# 일반 실행에서는 아래 동기화용 기본값을 그대로 사용합니다. 로컬 스텁이나 timeout 조정이 필요할 때만
# 주석을 해제하세요.
# BIZINFO_API_BASE_URL=https://apis.data.go.kr
# BIZINFO_API_CONNECT_TIMEOUT=2s
# BIZINFO_API_READ_TIMEOUT=10s

# 기업마당 공고 카탈로그 동기화. 사용자 검색은 이 MySQL 카탈로그를 읽습니다.
# PT0S는 앱 준비 뒤 즉시 한 번 실행하고, PT6H는 이전 동기화가 끝난 시점부터 6시간 뒤에 다시 실행한다는 뜻입니다.
BIZINFO_SYNC_ENABLED=true
BIZINFO_SYNC_INITIAL_DELAY=PT0S
BIZINFO_SYNC_FIXED_DELAY=PT6H
